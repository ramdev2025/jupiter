# Jupiter configuration. Copy to `.env` and fill in.
# `.env` is gitignored; `.env.example` is not. Never commit a real key.

# --- semantic conflict detection (optional) --------------------------------
# Jupiter works fully without this; the feature switches itself off when no
# key is set, and hard (same-path) conflicts are unaffected either way.
#
# Any OpenAI-compatible gateway works. These defaults target Model IQ.

JUPITER_LLM_API_KEY=sk-miq-replace-me
JUPITER_LLM_MODEL=deepseek-v4-pro-0813
JUPITER_LLM_BASE_URL=https://model-iq.aicore.accenture.com/v1

# Set to 0 to keep the key configured but the feature off.
# JUPITER_LLM_ENABLED=1

# OPENAI_API_KEY / OPENAI_BASE_URL are also honoured, so a shared .env from
# another tool usually works unchanged.

# --- server ----------------------------------------------------------------
# JUPITER_DB=/var/lib/jupiter/jupiter.db
# JUPITER_LOCK_TTL=300
